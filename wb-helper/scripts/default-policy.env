# 随包默认策略（本机 config/policy.env 不存在时生效，典型场景：云端沙盒刚解包）
# 解析方式与 config/policy.env 完全一致：sed 读 key=value，不 source、不 eval
# 优先级：进程环境变量 > config/policy.env > 本文件 > 脚本内置默认值

# 凭证在线续期（纯接口，日签必需）
WB_ALLOW_AUTO_REFRESH=1

# 凭证自取：沙盒没有桌面端，开了也没用；保持关闭
WB_ALLOW_SELF_FETCH=0

# 凭证上传/回写资料库：云端续期后必须回写，否则长效凭证 60 天后过期断链
WB_ALLOW_UPLOAD_CREDS=1
